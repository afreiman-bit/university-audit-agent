{
  "tenant": "example-university",
  "tenant_display_name": "Example University",
  "scope_name": "Full Site Audit",
  "contoro_api": {
    "endpoint": "https://your-contoro-instance.com/api/audit/inbound",
    "board_id": "your-site-health-board-id",
    "api_key": "YOUR_CONTORO_API_KEY"
  },
  "seed_urls": [
    "https://example.edu/programs/",
    "https://example.edu/departments/"
  ],
  "include_patterns": [
    "example.edu/programs/*",
    "example.edu/departments/*",
    "*.example.edu/*"
  ],
  "exclude_patterns": [
    "*/news/*",
    "*/events/*",
    "*/login*",
    "*/wp-admin*",
    "*/print*",
    "*?s=*",
    "*/feed/*",
    "*/tag/*",
    "*/page/*"
  ],
  "school_tagging": {
    "strategy": "path_parse",
    "program_pattern": "example.edu/programs/{school}/{program}",
    "extract_school_from": "path_segment_3",
    "extract_program_from": "path_segment_4",
    "subdomain_pattern": "{school}.example.edu",
    "extract_school_from_subdomain": true,
    "fallback": "untagged"
  },
  "canonical_priority": true,
  "sweep_policy": {
    "queue_threshold_percent": 60,
    "monthly_floor_enabled": true,
    "manual_trigger_enabled": true,
    "verification_sweep_enabled": true
  },
  "audit_scope": {
    "aeo_scoring": true,
    "technical_health": true,
    "wcag_triage": true,
    "prompt_gap": true,
    "cross_page_coherence": true,
    "fact_extraction": true,
    "card_metadata_tagging": true
  },
  "routing": {
    "schema_findings": "it-board",
    "content_findings": "content-board",
    "accessibility_findings": "accessibility-board",
    "gap_findings": "content-board",
    "conflict_findings": "content-board"
  },
  "elastic": {
    "index_name": "example-university-pages",
    "vector_field": "body_embedding",
    "similarity_threshold": 0.85
  },
  "ga4": {
    "property_id": "YOUR_GA4_PROPERTY_ID",
    "credentials_path": "./config/ga4_credentials.json",
    "anomaly_thresholds": {
      "bounce_rate_increase_percent": 20,
      "organic_session_drop_percent": 30,
      "engagement_time_drop_percent": 25
    }
  },
  "metadata": {
    "created": "2026-05-24",
    "version": "1.0",
    "notes": "Replace all placeholder values before running. Never commit real API keys — use environment variables in production."
  }
}

AUDIT_INBOUND_API_KEY=your-audit-inbound-api-key
